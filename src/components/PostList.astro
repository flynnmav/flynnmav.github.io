---
import type {CollectionEntry} from 'astro:content';
import {date,readingTime} from '../data/posts';
interface Props {posts:CollectionEntry<'blog'>[]}
const {posts}=Astro.props;
---
<div class="post-list">{posts.map(post=><article class="post-row" data-post data-category={post.data.category} data-tags={post.data.tags.join('|')}><div class="post-date">{date(post.data.pubDate)}<span>{post.data.category}</span></div><div><div class="eyebrow">学习与记录 · {readingTime(post.body)} 分钟阅读</div><h3><a href={'/blog/'+post.id+'/'}>{post.data.title}</a></h3><p>{post.data.description}</p><div class="tags">{post.data.tags.map(tag=><a href={'/blog/tags/'+encodeURIComponent(tag)+'/'}>#{tag}</a>)}</div></div><a class="row-arrow" href={'/blog/'+post.id+'/'} aria-label={'阅读'+post.data.title}>↗</a></article>)}</div>
