---
import type { Tool } from '../data/tools';
interface Props {
  tool: Tool;
  index: number;
}
const { tool, index } = Astro.props;
---

<article class="project-card">
  <div class="project-top">
    <span class="project-number">{String(index + 1).padStart(2, '0')}</span>
    <span class="status">浏览器本地</span>
  </div>
  <h3>
    <a href={'/tools/' + tool.slug + '/'}>{tool.name}</a>
  </h3>
  <p>{tool.summary}</p>
  <a class="project-link" href={'/tools/' + tool.slug + '/'}>
    打开工具 <span aria-hidden="true">↗</span>
  </a>
</article>
