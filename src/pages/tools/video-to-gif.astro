---
import SiteLayout from '../../layouts/SiteLayout.astro';
---

<SiteLayout
  title="视频转 GIF"
  description="在浏览器本地把视频片段转成 GIF。可设置起止时间、帧率、宽度和播放速度，文件不会上传。"
>
  <div class="container page gif-tool">
    <a class="text-link" href="/tools/">
      ← 所有小工具
    </a>
    <div class="eyebrow">TOOLS / 视频转 GIF</div>
    <h1>视频转 GIF</h1>
    <p class="lead">
      选择一段视频，截取起止时间，在浏览器里生成
      GIF。全程在本地处理，文件不会上传。
    </p>

    <div class="gif-card">
      <button type="button" id="drop" class="gif-drop">
        点击选择视频，或把视频拖到这里
        <small>
          支持 MP4 / WebM / MOV 等浏览器能播放的格式，全程在本地处理
        </small>
      </button>
      <input id="file" class="gif-file" type="file" accept="video/*" />
    </div>

    <div class="gif-card gif-hidden" id="editor">
      <video id="video" controls muted playsinline></video>
      <div class="gif-grid">
        <div class="gif-field">
          <label for="start">开始时间（秒）</label>
          <input id="start" type="number" value="0" min="0" step="0.1" />
        </div>
        <div class="gif-field">
          <label for="end">结束时间（秒）</label>
          <input id="end" type="number" value="3" min="0" step="0.1" />
        </div>
        <div class="gif-field">
          <label for="fps">帧率（FPS）</label>
          <input id="fps" type="number" value="10" min="1" max="30" />
        </div>
        <div class="gif-field">
          <label for="width">宽度（像素，高度按比例）</label>
          <input id="width" type="number" value="480" min="50" max="1920" />
        </div>
        <div class="gif-field">
          <label for="speed">播放速度倍数</label>
          <input
            id="speed"
            type="number"
            value="1"
            min="0.25"
            max="4"
            step="0.25"
          />
        </div>
      </div>
      <div class="gif-actions">
        <button type="button" id="setStart" class="gif-secondary">
          用当前画面作开始
        </button>
        <button type="button" id="setEnd" class="gif-secondary">
          用当前画面作结束
        </button>
        <button type="button" id="go" class="gif-primary">
          生成 GIF
        </button>
      </div>
      <div class="gif-bar gif-hidden" id="bar">
        <div></div>
      </div>
      <p id="status" class="gif-status" role="status"></p>
    </div>

    <div class="gif-card gif-hidden" id="out"></div>
  </div>
</SiteLayout>

<script>
  import '../../scripts/video-to-gif';
</script>
