---
import SiteLayout from '../../layouts/SiteLayout.astro';
import PostList from '../../components/PostList.astro';
import {getPosts} from '../../data/posts';
import {categories} from '../../data/site';
const posts=await getPosts();
const tags=[...new Set(posts.flatMap(p=>p.data.tags))];
---
<SiteLayout title="科研博客"><div class="container page"><div class="eyebrow">FIELD NOTES / 科研博客</div><h1>让思考，有迹可循。</h1><p class="lead">从原理到实践，记录自主系统与机器人领域的学习过程。</p><div class="filters" aria-label="文章分类"><a class="filter active" href="/blog/">全部文章</a>{categories.map(c=><a class="filter" href={'/blog/categories/'+encodeURIComponent(c)+'/'}>{c}</a>)}</div><PostList posts={posts}/><section class="content-section"><h2>按标签探索</h2><div class="tags large">{tags.map(tag=><a href={'/blog/tags/'+encodeURIComponent(tag)+'/'}>#{tag}</a>)}</div></section><a class="text-link" href="/rss.xml">通过 RSS 订阅更新 ↗</a></div></SiteLayout>
