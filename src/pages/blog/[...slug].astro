---
import {render} from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import {getPosts,date,readingTime} from '../../data/posts';
export async function getStaticPaths(){const posts=await getPosts();return posts.map((post,index)=>({params:{slug:post.id},props:{post,newer:posts[index-1],older:posts[index+1]}}));}
const {post,newer,older}=Astro.props;
const {Content,headings}=await render(post);
---
<SiteLayout title={post.data.title} description={post.data.description} article published={post.data.pubDate.toISOString()}><div class="container page"><a class="text-link" href="/blog/">← 返回科研博客</a><header class="article-header"><div class="eyebrow">{post.data.category} / 学习记录</div><h1>{post.data.title}</h1><p class="lead">{post.data.description}</p><p class="article-meta"><time datetime={post.data.pubDate.toISOString()}>{date(post.data.pubDate)}</time> · Leyan Liu · 约 {readingTime(post.body)} 分钟阅读</p><div class="tags">{post.data.tags.map(t=><a href={'/blog/tags/'+encodeURIComponent(t)+'/'}>#{t}</a>)}</div></header><div class="article-layout"><article class="prose"><Content/><nav class="article-pagination" aria-label="相邻文章"><div>{newer&&<a href={'/blog/'+newer.id+'/'}><small>较新文章</small>{newer.data.title} →</a>}</div><div>{older&&<a href={'/blog/'+older.id+'/'}><small>较早文章</small>{older.data.title} →</a>}</div></nav></article><aside class="toc"><div class="eyebrow">ON THIS PAGE / 目录</div><nav aria-label="文章目录">{headings.filter(h=>h.depth===2).map(h=><a href={'#'+h.slug}>{h.text}</a>)}</nav><a class="text-link" href="/rss.xml">订阅笔记 ↗</a></aside></div></div></SiteLayout>
